{
  "name": "vprinter-react-component",
  "version": "1.0.0",
  "description": "A reusable React virtual printer with FEIEYUN markup and quick ticket inputs.",
  "repository": "github:enrzh/vprinter-react-component",
  "homepage": "https://enrzh.github.io/vprinter-react-component/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "lib",
    "src/index.js",
    "src/index.d.ts",
    "src/markup.js",
    "src/markup.d.ts",
    "src/ticket.js",
    "src/ticket.d.ts",
    "src/VirtualPrinter.jsx",
    "src/VirtualPrinter.css",
    "src/TabletopPrinter.jsx",
    "src/tearGesture.js",
    "src/paperSurface.js",
    "src/receipt.js",
    "src/printerMarkup.js",
    "src/simpleTicket.js",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    },
    "./styles.css": "./lib/vprinter-react-component.css",
    "./markup": {
      "types": "./src/markup.d.ts",
      "import": "./lib/markup.js",
      "require": "./lib/markup.cjs",
      "default": "./lib/markup.js"
    },
    "./ticket": {
      "types": "./src/ticket.d.ts",
      "import": "./lib/ticket.js",
      "require": "./lib/ticket.cjs",
      "default": "./lib/ticket.js"
    }
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "build:lib": "vite build --mode library && vite build --mode library-cjs",
    "test:package": "vite build --mode library && vite build --mode library-cjs && node scripts/check-package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/*.test.js"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jsbarcode": "3.12.3",
    "three": "0.186.1",
    "uqr": "0.1.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  }
}
