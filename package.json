{
  "name": "vprinter-react-component",
  "version": "1.0.0",
  "description": "A reusable React virtual printer with FEIEYUN markup and quick ticket inputs.",
  "repository": "github:enrzh/vprinter-react-component",
  "homepage": "https://enrzh.github.io/vprinter-react-component/",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "dist",
    "src/index.js",
    "src/index.d.ts",
    "src/VirtualPrinter.jsx",
    "src/VirtualPrinter.css",
    "src/receipt.js",
    "src/printerMarkup.js",
    "src/simpleTicket.js",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/vprinter-react-component.css",
    "./markup": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./ticket": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "build:lib": "vite build --mode library",
    "prepare": "vite build --mode library",
    "test:package": "vite build --mode library && node scripts/check-package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/receipt.test.js"
  },
  "dependencies": {
    "jsbarcode": "3.12.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "html-to-image": "^1.11.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  }
}
